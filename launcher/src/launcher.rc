#include <winver.h>
#define SSNE_STRINGIFY_(v) #v
#define SSNE_STRINGIFY(v) SSNE_STRINGIFY_(v)
1 ICON "game.ico"

1 VERSIONINFO
 FILEVERSION SSNE_FILEVERSION
 PRODUCTVERSION SSNE_FILEVERSION
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "SSNE-RECOOP-Native"
   VALUE "FileVersion", SSNE_STRINGIFY(SSNE_RESOURCE_VERSION)
   VALUE "OriginalFilename", "SSNE-RECOOP-Native.exe"
   VALUE "ProductName", "SSNE-RECOOP-Native"
   VALUE "ProductVersion", SSNE_STRINGIFY(SSNE_RESOURCE_VERSION)
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
